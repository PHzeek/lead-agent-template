# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-6-luna            # small, low-cost model; swap if you prefer another
PRICE_INPUT_PER_M=0.10          # USD per 1M input tokens (check the OpenAI pricing page)
PRICE_OUTPUT_PER_M=0.50         # USD per 1M output tokens

# --- CRM ---
HUBSPOT_SERVICE_KEY=pat-na1-...

# --- Email ---
RESEND_API_KEY=re_...
FROM_EMAIL=Your Name <hello@yourdomain.com>   # must be on a domain verified in Resend
SENDER_NAME=Your Name
OWNER_EMAIL=you@yourdomain.com              # hot-lead and failure alerts go here
SEND_EMAILS=false                           # keep false until your domain shows Verified in Resend

# --- Links ---
BOOKING_URL=https://cal.com/your-handle/discovery-call
AUDIT_CHECKLIST_URL=                        # optional: a resource link for warm and cold leads; leave empty to skip

# --- App ---
DATABASE_URL=sqlite:///./leads.db           # Neon Postgres URL in production
CRON_SECRET=change-me-long-random-string
ALLOWED_ORIGINS=http://localhost:8000

# --- Scripts ---
TEST_EMAIL=you@yourdomain.com               # scripts/send_test_lead.py sends to you+hot-xxxx@... 